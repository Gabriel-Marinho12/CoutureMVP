# Copy to backend/.env and adjust.

# devnet | testnet | mainnet-beta | localnet (solana-test-validator, see README)
SOLANA_CLUSTER=devnet
# Comma-separated; the client fails over in order. Add a dedicated provider (Helius, Triton, QuickNode) for production.
SOLANA_RPC_URLS=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# Priority fee for congested periods (mainnet). 0 disables it.
SOLANA_PRIORITY_FEE_MICROLAMPORTS=0

# Platform fee-payer wallet (Solana CLI JSON format). COUTURE_KEYPAIR may hold the JSON directly instead.
COUTURE_KEYPAIR_PATH=.secrets/platform-keypair.json

# Access keys for write endpoints, one per designer/studio: `principal=key` pairs, comma-separated.
# A key can only certify designs registered with that same key's principal.
# Principal: lowercase a-z 0-9 _ -. Key: 16+ printable ASCII (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
# A bare key (no `principal=`) acts as `default`, which also owns designs registered before principals existed.
# Empty = open (development only; refused on mainnet).
COUTURE_API_KEYS=
# Certificate spend caps (each mint costs platform SOL and a Merkle-tree leaf).
COUTURE_CERT_LIMIT_PER_HOUR=30
COUTURE_MAX_CERTS_PER_DESIGN=500
# Origins allowed to call the API from a browser (e.g. the GitHub Pages site).
COUTURE_CORS_ORIGINS=https://gabriel-marinho12.github.io
# Public URL of this API, used in certificate metadata read by wallets.
COUTURE_PUBLIC_BASE_URL=http://localhost:8000
COUTURE_MAX_UPLOAD_MB=50
# Set after `python -m app.cli create-tree` (otherwise read from the database).
COUTURE_MERKLE_TREE=
